# agentmoat: gVisor-enabled kind node image.
#
# Extends the upstream kindest/node image to bake in:
#
#   /usr/local/bin/runsc                       (gVisor runtime)
#   /usr/local/bin/containerd-shim-runsc-v1    (containerd v2 shim)
#   /usr/local/bin/gvisor-bin/                 (runsc sidecar binaries)
#   /etc/containerd/runsc.toml                 (runsc platform/network config)
#
# The matching containerd runtime registration (the
# `[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.gvisor]` block) is
# applied at cluster creation time by kind, via the `containerdConfigPatches`
# field in kind/cluster.yaml. We deliberately don't bake it into the image
# because kindest/node templates parts of its containerd config at first
# boot, and kind's patch mechanism is the supported integration point.
#
# Build:
#
#   docker buildx build \
#     --platform "linux/$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')" \
#     --build-arg GVISOR_VERSION=20260914.0 \
#     --build-arg KIND_NODE_VERSION=v1.32.5 \
#     -t agentmoat-kind-gvisor:dev \
#     -f kind/Dockerfile.gvisor-node kind/
#
# The convenience wrapper scripts/build-gvisor-node.sh sets all of this for
# you and is what `make kind-build` (and `make kind-up`) call.
#
# Notes on running gVisor inside a kind node:
#
#   - kind launches each node container with --privileged, which implies
#     seccomp=unconfined and apparmor=unconfined. gVisor's systrap platform
#     needs both, so no extra Docker flags are required.
#   - We only ship the systrap-capable runsc; the KVM platform is
#     unavailable inside Docker Desktop's Linux VM anyway. runsc.toml pins
#     platform=systrap so this is explicit.
#   - We do NOT bake the runtime *registration* (the containerd `[runtimes]`
#     stanza) into the image. Kind merges its own templated config.toml at
#     first boot, and the canonical place to add extra runtimes is via
#     kind's containerdConfigPatches. Keeping the registration in
#     cluster.yaml also means an operator can read what runtimes exist
#     without exec'ing into the node.

ARG KIND_NODE_VERSION=v1.32.5

# Pinned to a tested gVisor release. Bump with scripts/bump-gvisor-version.sh,
# which rewrites every copy of the pin and verifies that both archs publish
# `gvisor.tar.bz2` and `gvisor.tar.bz2.sha512` under
# https://storage.googleapis.com/gvisor/releases/release/<tag>/<arch>/.
# The weekly gvisor-drift.yml workflow opens that PR automatically; see
# docs/gvisor-version.md. Declared before the first FROM so both stages
# below can read it (each stage re-declares it without a value).
ARG GVISOR_VERSION=20260914.0

# ---------------------------------------------------------------------------
# Stage 1: fetch and verify the gVisor release tarball.
# ---------------------------------------------------------------------------
#
# From release 20260831.0 on, gVisor publishes one tarball per arch instead
# of separate `runsc` and `containerd-shim-runsc-v1` files. The tarball
# holds:
#
#   runsc
#   containerd-shim-runsc-v1
#   gvisor-bin/   (sidecars: gvisor_sentry, checkpointgofer, ...)
#
# runsc looks for gvisor-bin/ next to its own binary, and from 20260831.0
# its default --sidecar-usage-policy refuses the old fallback of running
# copies embedded in runsc. So gvisor-bin/ is not optional: without it the
# sandbox does not start.
#
# Why a separate stage: kindest/node has no bzip2 (or zstd), and we do not
# want download tools in the node image. This stage runs on the build
# host's own platform ($BUILDPLATFORM), so a cross-arch build (amd64 image
# on an arm64 Mac) does not emulate curl and tar; TARGETARCH still picks
# the right gVisor arch.
FROM --platform=$BUILDPLATFORM debian:trixie-slim AS gvisor
ARG GVISOR_VERSION
ARG TARGETARCH
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends bzip2 ca-certificates curl; \
    rm -rf /var/lib/apt/lists/*

# Verify the tarball with the SHA512 file from the same release dir, so a
# tampered archive fails the local check (the SHA file's path is also bound
# to a specific release/arch, so an attacker would have to compromise the
# GCS bucket for both files to slip a bad archive through).
#
# Why not gVisor's apt repository: this image must be reproducible.
# `apt-get install runsc` resolves to whatever is newest at build time,
# which makes two builds of the same commit install different binaries.
# The pinned artifact URL plus the checksum keeps the build deterministic;
# the drift workflow keeps the pin fresh.
RUN set -eux; \
    case "${TARGETARCH:-$(dpkg --print-architecture 2>/dev/null || echo unknown)}" in \
        amd64) GVISOR_ARCH=x86_64 ;; \
        arm64) GVISOR_ARCH=aarch64 ;; \
        *) echo "unsupported TARGETARCH='${TARGETARCH}'" >&2; exit 1 ;; \
    esac; \
    BASE="https://storage.googleapis.com/gvisor/releases/release/${GVISOR_VERSION}/${GVISOR_ARCH}"; \
    mkdir -p /fetch /out/usr/local/bin; cd /fetch; \
    for f in gvisor.tar.bz2 gvisor.tar.bz2.sha512; do \
        curl --fail --silent --show-error --location --remote-name "${BASE}/${f}"; \
    done; \
    sha512sum -c gvisor.tar.bz2.sha512; \
    tar -xjf gvisor.tar.bz2 -C /out/usr/local/bin; \
    test -x /out/usr/local/bin/runsc; \
    test -x /out/usr/local/bin/containerd-shim-runsc-v1; \
    test -d /out/usr/local/bin/gvisor-bin

# ---------------------------------------------------------------------------
# Stage 2: the kind node image.
# ---------------------------------------------------------------------------
FROM kindest/node:${KIND_NODE_VERSION}
ARG GVISOR_VERSION

# Record the baked gVisor release on the image. scripts/build-gvisor-node.sh
# compares this label with the requested GVISOR_VERSION and rebuilds when
# they differ, so a pin bump is never silently ignored by the tag cache.
LABEL org.agentmoat.gvisor-version="${GVISOR_VERSION}"

# COPY writes root-owned files and keeps the tarball's 0755 modes. The
# trailing slash merges into /usr/local/bin instead of replacing it.
COPY --from=gvisor /out/usr/local/bin/ /usr/local/bin/
RUN /usr/local/bin/runsc --version

# runsc.toml controls platform + network for the gVisor sandbox. It is
# loaded by the shim because the runtime registration (in cluster.yaml's
# containerdConfigPatches) points ConfigPath here.
COPY runsc.toml /etc/containerd/runsc.toml
RUN chmod 0644 /etc/containerd/runsc.toml
